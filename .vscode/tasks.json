			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Backend Django Server",
			"type": "shell",
			"command": "C:\\Users\\idaba\\projects\\seller-product-management\\backend\\.venv\\Scripts\\python.exe",
			"args": [
				"backend\\manage.py",
